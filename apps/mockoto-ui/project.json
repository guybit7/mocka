{
  "name": "mockoto-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/mockoto-ui/src",
  "projectType": "application",
  "tags": ["mockoto-ui"],
  "// targets": "to see all targets run: nx show project mockoto-ui --web",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "options": {
        "outputPath": "dist/apps/mockoto-ui",
        "index": "apps/mockoto-ui/src/index.html",
        "main": "apps/mockoto-ui/src/main.tsx",
        "assets": ["apps/mockoto-ui/src/favicon.ico", "apps/mockoto-ui/src/assets"],
        "styles": ["apps/mockoto-ui/src/styles.css"],
        "envFile": ".env.production"
      },
      
    "configurations": {
      "production": {
        "optimization": true,
        "sourceMap": false,
        "extractCss": true,
        "namedChunks": false,
        "outputHashing": "all",
        "buildOptimizer": true
      },
      "development": {
        "envFile": ".env",
        "sourceMap": true,
        "optimization": false
      }
    }
    }
  }
}
